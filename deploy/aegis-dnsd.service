# aegis-dnsd —— DNS 引擎
#
# 只有本进程需要绑定 53/853/443 这类特权端口，因此也是唯一需要
# CAP_NET_BIND_SERVICE 的服务。apid 监听 8080/8443，不需要任何 capability。
[Unit]
Description=AegisDNS Engine (dnsd) - DoT/DoH/UDP/TCP resolver
Documentation=https://github.com/50521136/aegis-dns
# 不依赖 apid：dnsd 只读磁盘上的配置快照，apid 挂掉它照常解析。
After=network-online.target
Wants=network-online.target
# 不限制重启次数：DNS 中断的影响远大于重启风暴。
# 这一项属于 [Unit] 段 —— 写进 [Service] 会被 systemd 忽略（只打一条
# "Unknown key name" 警告），实际生效的是默认启动限流，重启风暴时服务会被卡住。
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/aegis/aegis-dnsd --config /opt/aegis/config.yaml
WorkingDirectory=/opt/aegis
EnvironmentFile=-/opt/aegis/.env

Restart=always
RestartSec=3

# 优雅关闭：留出时间把最后一批统计落库并关掉监听。
KillSignal=SIGTERM
TimeoutStopSec=15

# --- 权限加固（文档 10.3）---
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
# 唯一可写的目录：数据目录（SQLite + 快照 + 证书）。
ReadWritePaths=/opt/aegis/data
LimitNOFILE=65535

# --- 资源约束 ---
# 参考文档 15.2 容量规划：小型部署 256MB 足够；
# 中型（<500 用户 / <100 万规则）建议提到 1G。
#
# 这三个值配套使用，缺一个都会出问题：
#
# GOMEMLIMIT 是 Go 运行时的软上限，只管 GC 策略、不预分配。设太小会让
# 快照重建（解析 48MB JSON）期间被迫频繁 GC，表现为规则变更时 CPU 尖峰
# 和延迟抖动。设得比 MemoryMax 低 200MB 左右，留出非堆开销的余量。
#
# MemoryHigh 是「黄灯」：超过就限速分配并积极回收，进程变慢但不会被杀。
# MemoryMax 是硬上限，超了只杀这个 unit —— 有它才不会重演
# anon-rss 涨到 1.42GB、整机 1.7GB 被内核连锅端的事故。
#
# MemorySwapMax=0 对 DNS 尤其重要：dnsd 一旦被换到 swap，一次解析要等
# 磁盘 I/O，延迟从毫秒变秒级。宁可干净地 OOM 重启，也不要带着几千条
# TLS 连接慢慢爬。
Environment=GOMEMLIMIT=800MiB
MemoryHigh=900M
MemoryMax=1G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
